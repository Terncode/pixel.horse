.container-fluid.p-1
	.form-inline
		.form-group
			a.btn.btn-default(routerLink="/")
				fa-icon([icon]="homeIcon")
		.form-group
			scale-picker.ms-1([(scale)]="scale" (scaleChange)="redraw()")
		.form-group
			.input-group.ms-1(style="width: 200px;")
				input.form-control([(ngModel)]="name" placeholder="name")
				.input-group-append.dropdown(dropdown)
					button.btn.btn-default.dropdown-toggle(dropdownToggle)
					.dropdown-menu.dropdown-menu-end(*dropdownMenu)
						a.dropdown-item(*ngFor="let e of entities" (click)="setEntity(e)")
							| {{e.name}}
			button.btn.btn-default.ms-1((click)="saveEntity()" [disabled]="!name")
				fa-icon([icon]="saveIcon" [fixedWidth]="true")
			button.btn.btn-danger.ms-1((click)="setEntity(null)")
				fa-icon([icon]="eraserIcon" [fixedWidth]="true")
			button.btn.btn-danger.ms-1((click)="removeEntity()")
				fa-icon([icon]="trashIcon" [fixedWidth]="true")

	.float-start.mt-1.me-2
		canvas(#canvas width=512 height=512 (mousedown)="mousedown($event)" (agDrag)="drag($event)" agDragRelative="self")

		.form-group.d-flex
			label.control-label.text-muted draw:
			custom-checkbox.ms-2([(checked)]="drawCenter" (checkedChange)="changed()") center
			custom-checkbox.ms-2([(checked)]="drawSelection" (checkedChange)="changed()") selection
			custom-checkbox.ms-2([(checked)]="drawHold" (checkedChange)="changed()") as held

	div
		.form-group(*ngFor="let p of parts")
			.form-inline(*ngIf="p.type === 'sprite'")
				label.text-muted sprite:
				input.form-control.ms-1(
					[(ngModel)]="p.sprite" (input)="changed()" style="width: 200px;" [typeahead]="sprites" (typeaheadOnSelect)="changed()")
				label.ms-1 x:
				input.form-control.input-sm.ms-1(type="number" [ngModel]="-p.x" (ngModelChange)="p.x = -$event" (input)="changed()" min="-1000" max="1000")
				label.ms-1 y:
				input.form-control.input-sm.ms-1(type="number" [ngModel]="-p.y" (ngModelChange)="p.y = -$event" (input)="changed()" min="-1000" max="1000")
				button.btn.btn-sm.btn-default.ms-1((click)="centerPart(p)" title="Center sprite")
					fa-icon([icon]="crosshairsIcon" [fixedWidth]="true")
				button.btn.btn-sm.btn-danger.ms-1((click)="removePart(p)" title="Remove part")
					fa-icon([icon]="trashIcon" [fixedWidth]="true")

			.form-inline(*ngIf="p.type === 'cover' || p.type === 'collider' || p.type === 'pickable'")
				label.text-muted {{p.type}}:
				label.ms-1 x:
				input.form-control.input-sm.ms-1(type="number" [(ngModel)]="p.x" (input)="changed()" min="-1000" max="1000")
				label.ms-1 y:
				input.form-control.input-sm.ms-1(type="number" [(ngModel)]="p.y" (input)="changed()" min="-1000" max="1000")
				.form-inline(*ngIf="p.type === 'cover' || p.type === 'collider'")
					label.ms-1 w:
					input.form-control.input-sm.ms-1(type="number" [(ngModel)]="p.w" (input)="changed()" min="1" max="1000")
					label.ms-1 h:
					input.form-control.input-sm.ms-1(type="number" [(ngModel)]="p.h" (input)="changed()" min="1" max="1000")
				button.btn.btn-sm.btn-danger.ms-1((click)="removePart(p)" title="Remove part")
					fa-icon([icon]="trashIcon" [fixedWidth]="true")

		hr

		.form-group.form-inline
			button.btn.btn-sm.btn-default.ms-1((click)="addPart('sprite')")
				fa-icon.me-1([icon]="plusIcon" [fixedWidth]="true")
				| Sprite
			button.btn.btn-sm.btn-default.ms-1((click)="addPart('cover')")
				fa-icon.me-1([icon]="plusIcon" [fixedWidth]="true")
				| Cover
			button.btn.btn-sm.btn-default.ms-1((click)="addPart('collider')")
				fa-icon.me-1([icon]="plusIcon" [fixedWidth]="true")
				| Collider
			button.btn.btn-sm.btn-default.ms-1((click)="addPart('pickable')")
				fa-icon.me-1([icon]="plusIcon" [fixedWidth]="true")
				| Pickable
